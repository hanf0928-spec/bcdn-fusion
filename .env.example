# ============================
# Server
# ============================
PORT=3000
# 监听地址：0.0.0.0 表示监听所有网卡（外网可访问）；127.0.0.1 仅本机
HOST=0.0.0.0
NODE_ENV=development

# ============================
# Database
# ============================
DB_PATH=./data/bcdn.db

# ============================
# Telegram Bot Alert
# ============================
# 1) Create a bot via @BotFather, get the TOKEN
# 2) Add the bot into your group, give it permission to send messages
# 3) Get the chat_id (negative for groups). Tip: send a msg to the group,
#    visit https://api.telegram.org/bot<TOKEN>/getUpdates to find chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================
# Alert scheduler
# ============================
# cron expression - default: every hour at :00
ALERT_CRON=0 * * * *

# Re-alert cooldown in minutes (avoid spamming the same low-balance alert)
ALERT_COOLDOWN_MIN=360

# ============================
# Upstream provider sync
# ============================
# How often to pull traffic from upstream providers (cron expression)
SYNC_CRON=15 * * * *

# Default look-back window (in days) when triggering a sync without an
# explicit start_date. Useful for first-time deploy / new customers so the
# scheduler / "Sync All" button automatically back-fills history.
# Leave blank or 0 to fall back to "1st day of the current month".
SYNC_DEFAULT_DAYS=90

# Default base URLs (per-customer api_base_url overrides these)
SOURCE1_BASE_URL=http://cdn-hw.com
# flux unit: byte | kb | mb | gb (default byte)
SOURCE1_FLUX_UNIT=byte
SOURCE2_BASE_URL=https://api.cdnetworks.com
SOURCE2_PATH=/api/report/traffic
# X-Time-Zone header value (e.g. GMT+08:00 for Asia/Shanghai)
SOURCE2_TIMEZONE=GMT+08:00

# ----- EO (Tencent Cloud EdgeOne) -----
# Auth uses TC3-HMAC-SHA256:
#   customers.api_user = SecretId
#   customers.api_key  = SecretKey
# customers.zone_ids   = JSON array of zone-ids; empty / null defaults to ["*"]
EO_BASE_URL=https://teo.tencentcloudapi.com
# Optional region (EO is account-level so this is only used as a hint header)
EO_REGION=
# Default metric(s) for daily traffic. Comma-separated; values are summed.
# Default = "acc_flux,smt_flux" (内容加速 + 智能加速，单位 byte).
# Legacy single-metric env var `EO_METRIC` is still honoured if set.
EO_METRICS=acc_flux,smt_flux

# ----- YCN2 -----
# Base URL for YCN2 API endpoint
YCN2_BASE_URL=https://api.ycn2.example.com
# Traffic unit: byte | kb | mb | gb (default byte)
YCN2_FLUX_UNIT=byte

# ============================
# Auth (basic protection for the admin UI)
# ============================
ADMIN_TOKEN=change-me-please
